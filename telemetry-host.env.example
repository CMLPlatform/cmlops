# The machine's telemetry agent settings for the .env of the repo that runs it,
# rendered by the CML host overlay (.copier-answers.cml-host.yml). Copy them into .env
# and fill in OTLP_AUTH_TOKEN there: no secret belongs in this file.
# PROJECT and ENVIRONMENT name the machine's owner; host-level series carry them.
PROJECT=cmlops
ENVIRONMENT=prod
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.cml-relab.org
# The hub's shared ingest token, from the monitoring operator.
OTLP_AUTH_TOKEN=
# Only if the machine's egress crosses a Cloudflare WAF.
TELEMETRY_EDGE_KEY=
# 1 on a machine with an NVIDIA card: deploy tooling reads it to include compose.telemetry.gpu.yml.
GPU_METRICS=1
