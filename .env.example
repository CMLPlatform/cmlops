# Copy to .env and fill in. Docker Compose and just both read it; ${HOME} is expanded.

# The host user the services run as, so the MLflow store and the token file stay theirs: `id -u`, `id -g`.
CMLOPS_UID=1000
CMLOPS_GID=1000

# The public hostname of the MLflow UI on the tunnel: <subdomain>.<domain> from infra/.
CMLOPS_MLFLOW_HOST=mlflow.example.org
# The store: mlflow.db and artifacts/.
CMLOPS_MLFLOW_STORE=${HOME}/.local/share/mlflow
# CMLOPS_MLFLOW_PORT=5000

# Private state, mode 700: tunnel-token, terraform.tfvars, the OpenTofu state and its .terraform dir.
CMLOPS_STATE=${HOME}/.local/state/cmlops
